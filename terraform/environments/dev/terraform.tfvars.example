project_name        = "gitops-platform"
aws_region          = "eu-central-1"
environment         = "dev"
vpc_cidr            = "10.0.0.0/16"
ssh_public_key_path = "~/.ssh/gitops-platform.pub"

# Your public IP for bastion SSH access — run `curl ifconfig.me` and append /32.
# Never set this to 0.0.0.0/0.
my_ip = "203.0.113.10/32"
